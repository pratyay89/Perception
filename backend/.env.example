# Copy this file to ".env" and adjust. Every value below has a working default,
# so for a first local run the only thing you need to fill in is GROQ_API_KEY.

# development: API docs at /docs, built-in secret key allowed
# production:  no /docs, SECRET_KEY is required
ENVIRONMENT=development

# Secret used to sign login tokens. Required in production.
# In development, leaving it empty creates a random key in ".dev_secret_key".
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# How long a login stays valid, in minutes (default: 1 day)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---------------------------------------------------------------
# SQLite needs no setup and is fine for trying the project locally:
DATABASE_URL=sqlite+aiosqlite:///./perception.db
# PostgreSQL (start one with "docker compose up -d db" from the project root):
# DATABASE_URL=postgresql+asyncpg://perception:perception@localhost:5432/perception
# Set to true to print every SQL statement
DATABASE_ECHO=false

# Web addresses that may call this API from a browser (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI evaluation (Groq) ---------------------------------------------------
# Create a free key at https://console.groq.com/keys
# Without a key everything works except the "Evaluate" buttons.
GROQ_API_KEY=
# Any Groq chat model. See https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning models only: low, medium or high. Use "none" for other models.
GROQ_REASONING_EFFORT=low
# Token budget for one evaluation (reasoning + answer)
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_TIMEOUT_SECONDS=45
# Retries on rate limits, timeouts and server errors
GROQ_MAX_RETRIES=3
# Answers sent to the model at the same time. Keep low on the free tier.
LLM_MAX_CONCURRENCY=2

# --- Monthly limits per user ------------------------------------------------
PAPERS_CREATED_MONTHLY_LIMIT=20
SUBMISSIONS_MADE_MONTHLY_LIMIT=100
LLM_TOKEN_BALANCE_MONTHLY_LIMIT=200000
